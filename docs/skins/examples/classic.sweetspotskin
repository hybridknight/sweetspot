// Sweet Spot · skin development starter
// Rename id and name before importing your own design. Save as UTF-8 .sweetspotskin.
// This is JSON with comments: data only, no scripts, HTML, CSS or remote assets.
// theme: colors, corners, font and finish. layout: width, arrangement, module order.
// artwork: SVG primitives in a 100 × 100 viewBox. Allowed: rect, circle, path.
// Paint: #RRGGBB, none, surface, text, accent, metal (app-owned gradient).
// settings: labels + help text, safe targets, options and defaults.
// Exported defaults reflect your current skin settings; no account or playback data.
{
  "formatVersion": 1,
  "id": "my-classic",
  "name": "My Classic",
  "author": "Sweet Spot",
  "description": "Modern-retro silver modules, an instrument display and a Winamp-inspired playlist.",
  // Plain-text development notes. These notes also appear under Develop your own skin.
  "guide": [
    "Start by changing id, name, author and description. IDs use lowercase letters, digits and hyphens, and must be unique.",
    "theme defines the default palette. Color values must be six-digit hex. Choose a registered font ID for font and optional headingFont: system, mono, classic, google-inter, google-cinzel or google-manrope. The Google Fonts are bundled offline. Fonts belong to the theme, not user-selectable settings.",
    "layout.modules contains media, transport, equalizer and queue once each. Change their order; choose stack or columns, and a width from 360 to 1000.",
    "artwork.panel and artwork.button are SVG shapes in a 100 × 100 coordinate space. Use rect, circle or path; colors can refer to surface, text, accent or metal. These graphics scale with the player.",
    "settings creates this skin's own style and feature controls. Each control has a friendly label, description, group and a supported target. Targets attach to app-owned behavior; custom code is never loaded.",
    "For ranges, corner radius uses 0–28 px; glass depth and ambient glow use 0–100 percent. Select options must use the supported values shown in this starter. Boolean controls use true/false.",
    "Save your file, use Import skin in player settings, then select it. Re-import the same ID to update it. Your other skins and EQ settings stay separate.",
    "This file can contain // and /* */ comments. Do not add JavaScript, HTML, CSS, raw SVG, network URLs or file paths. Unknown properties are rejected."
  ],
  // Default palette. Use #RRGGBB; radius is 0–28 px; font/headingFont use registered font IDs: system, mono, classic, google-inter, google-cinzel, google-manrope. Google Fonts are bundled locally.
  "theme": {
    "surface": "#dce0e8",
    "text": "#2e3b50",
    "muted": "#58657c",
    "accent": "#bad4ef",
    "border": "#748197",
    "radius": 8,
    "font": "classic",
    "finish": "metal"
  },
  // Player width (360–1000 px), stack or columns, and each module exactly once.
  "layout": {
    "width": 460,
    "arrangement": "stack",
    "modules": [
      "transport",
      "equalizer",
      "media",
      "queue"
    ]
  },
  // SVG shape arrays in a 100 × 100 viewBox. Nothing here can load scripts or URLs.
  // Example: { "kind": "rect", "x": 1, "y": 1, "width": 98, "height": 98, "rx": 3, "fill": "surface" }
  "artwork": {
    "panel": [
      {
        "kind": "rect",
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100,
        "rx": 0,
        "fill": "metal",
        "stroke": "none",
        "strokeWidth": 0
      },
      {
        "kind": "path",
        "d": "M 3 5 H 97 M 3 95 H 68 L 74 89 H 97",
        "fill": "none",
        "stroke": "#ffffff",
        "strokeWidth": 1,
        "opacity": 0.35
      }
    ],
    "button": [
      {
        "kind": "circle",
        "cx": 50,
        "cy": 50,
        "r": 47,
        "fill": "metal",
        "stroke": "#66758b",
        "strokeWidth": 3
      },
      {
        "kind": "circle",
        "cx": 50,
        "cy": 48,
        "r": 37,
        "fill": "none",
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "opacity": 0.8
      }
    ]
  },
  // Each entry becomes a setting in this skin. Label and description are shown to users.
  // Keep target/type compatible. default sets the initial value; group is style or features.
  "settings": [
    {
      "key": "finish",
      "label": "Finish",
      "description": "Coordinated surfaces, text and accents in three balanced finishes.",
      "group": "style",
      "target": "finish",
      "type": "select",
      "options": [
        {
          "value": "original",
          "label": "Original"
        },
        {
          "value": "graphite",
          "label": "Graphite"
        },
        {
          "value": "midnight",
          "label": "Midnight"
        }
      ],
      "default": "original"
    },
    {
      "key": "accent",
      "label": "Accent color",
      "description": "Color for progress, selection, and the equalizer curve.",
      "group": "style",
      "target": "accent",
      "type": "color",
      "default": "#bad4ef"
    },
    {
      "key": "density",
      "label": "Playlist spacing",
      "description": "Compact fits more tracks; comfortable gives each row more room.",
      "group": "style",
      "target": "density",
      "type": "select",
      "options": [
        {
          "value": "comfortable",
          "label": "Comfortable"
        },
        {
          "value": "compact",
          "label": "Compact"
        }
      ],
      "default": "compact"
    },
    {
      "key": "spectrumEnabled",
      "label": "Live spectrum",
      "description": "Follow the music with a live visualizer. Bars settle when paused.",
      "group": "features",
      "target": "spectrumEnabled",
      "type": "boolean",
      "default": true
    },
    {
      "key": "queueExpanded",
      "label": "Show playlist",
      "description": "Keep the playlist panel visible in the player.",
      "group": "features",
      "target": "queueExpanded",
      "type": "boolean",
      "default": true
    },
    {
      "key": "eqExpanded",
      "label": "Show equalizer",
      "description": "Show ten-band controls. Hiding this panel does not turn EQ off.",
      "group": "features",
      "target": "eqExpanded",
      "type": "boolean",
      "default": true
    },
    {
      "key": "videoExpanded",
      "label": "Show video",
      "description": "Show the current music video when available. Audio-only tracks show artwork.",
      "group": "features",
      "target": "videoExpanded",
      "type": "boolean",
      "default": false
    },
    {
      "key": "showArtist",
      "label": "Artist names",
      "description": "Include artist names in the playlist.",
      "group": "features",
      "target": "showArtist",
      "type": "boolean",
      "default": true
    },
    {
      "key": "showDurations",
      "label": "Track durations",
      "description": "Include each track's duration when YouTube Music provides it.",
      "group": "features",
      "target": "showDurations",
      "type": "boolean",
      "default": true
    }
  ]
}
