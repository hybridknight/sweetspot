{
	"name": "sweetspot",
	"description": "Your desktop home for YouTube Music.",
	"version": "1.0.1",
	"private": false,
	"author": {
		"name": "Sweet Spot contributors"
	},
	"homepage": "https://sweetspot.bkk.ooo",
	"desktopName": "sweetspot",
	"main": "./out/main/index.js",
	"scripts": {
		"format": "prettier --write .",
		"lint": "biome lint ./src",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"generate:routes": "tsr generate",
		"typecheck:web": "pnpm generate:routes && tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "pnpm typecheck:node && pnpm typecheck:web",
		"start": "electron-vite preview",
		"dev": "electron-vite dev --watch",
		"build": "pnpm typecheck && electron-vite build",
		"postinstall": "patch-package --patch-dir patches && pnpm exec install-electron && electron-builder install-app-deps",
		"release:nocheck": "cross-env NODE_ENV=production electron-vite build && electron-builder",
		"release": "cross-env NODE_ENV=production pnpm build && electron-builder",
		"release:compile": "cross-env NODE_ENV=production pnpm build",
		"release:pack": "cross-env NODE_ENV=production electron-builder",
		"release:pack:win": "cross-env NODE_ENV=production electron-builder --win",
		"release:pack:mac": "cross-env NODE_ENV=production electron-builder --mac",
		"build:unpack": "pnpm build && electron-builder --dir",
		"build:win": "pnpm build && electron-builder --win",
		"build:mac": "pnpm build && electron-builder --mac",
		"biome:lint": "biome lint ./src",
		"biome:format": "biome format ./src --write",
		"biome:check": "biome check ./src",
		"biome:check:apply": "biome check ./src --write",
		"test": "pnpm -w exec vitest run apps/sweetspot",
		"test:equalizer:audio": "node scripts/check-equalizer.cjs",
		"test:player:ui": "node scripts/check-player.cjs",
		"test:equalizer:ui": "node scripts/check-equalizer-ui.cjs",
		"test:watch": "pnpm -w exec vitest apps/sweetspot"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@base-ui/react": "^1.6.0",
		"@better-fetch/fetch": "^1.3.1",
		"@electron-toolkit/utils": "^3.0.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@hono/node-server": "^2.0.12",
		"@logtape/file": "^2.3.1",
		"@logtape/logtape": "^2.3.1",
		"@mdx-js/mdx": "^3.1.1",
		"@paralleldrive/cuid2": "^2.2.2",
		"@remixicon/react": "^4.9.0",
		"@tanstack/react-query": "^4.44.0",
		"@tanstack/react-router": "^1.170.18",
		"@trpc/client": "10.45.4",
		"@trpc/react-query": "10.45.4",
		"@trpc/server": "10.45.4",
		"@venipa/xosms": "0.8.5",
		"bonjour-service": "1.4.4",
		"castv2": "file:../../vendor/castv2",
		"cnfast": "^0.1.0",
		"date-fns": "^2.29.1",
		"dompurify": "^3.4.13",
		"electron-conf": "^1.3.0",
		"electron-trpc": "file:../../vendor/electron-trpc",
		"electron-updater": "^6.8.9",
		"hono": "^4.13.0",
		"lodash-es": "^4.17.21",
		"lucide-react": "^1.28.0",
		"motion": "^13.0.0",
		"next-themes": "^0.4.6",
		"node-vibrant": "^4.0.4",
		"non.geist": "^1.0.4",
		"pretty-bytes": "^7.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"remark-gfm": "^4.0.1",
		"rxjs": "^7.8.0",
		"sass": "^1.32.8",
		"semver": "7.7.4",
		"shadcn": "^4.16.1",
		"sonner": "^2.0.7",
		"styled-jsx": "^5.1.7",
		"thenby": "^1.3.4",
		"tw-animate-css": "^1.4.0",
		"ws": "^8.21.2",
		"yaml": "^2.6.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@electron-toolkit/eslint-config": "^1.0.2",
		"@electron-toolkit/eslint-config-ts": "^2.0.0",
		"@electron-toolkit/tsconfig": "^1.0.1",
		"@electron/fuses": "^1.8.0",
		"@rushstack/eslint-patch": "^1.10.4",
		"@swc/core": "^1.15.47",
		"@swc/plugin-styled-jsx": "^13.15.0",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/router-cli": "^1.167.22",
		"@tanstack/router-plugin": "^1.167.18",
		"@types/events": "^3.0.0",
		"@types/lodash-es": "^4.17.6",
		"@types/node": "^24.12.0",
		"@types/react": "^19.2.10",
		"@types/react-dom": "^19.2.3",
		"@types/semver": "7.5.8",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^5.31.0",
		"@typescript-eslint/parser": "^5.31.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"class-variance-authority": "^0.7.0",
		"cross-env": "^7.0.3",
		"electron": "44.9.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"eslint": "^8.57.0",
		"fast-glob": "^3.3.3",
		"lefthook": "^1.11.13",
		"node-gyp": "^13.0.1",
		"patch-package": "^8.0.0",
		"prettier": "^3.3.3",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-svgr": "^4.5.0"
	},
	"license": "CC0-1.0",
	"optionalDependencies": {
		"bufferutil": "^4.0.6",
		"utf-8-validate": "^5.0.8"
	},
	"repository": "https://github.com/hybridknight/sweetspot"
}
